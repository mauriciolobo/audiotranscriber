# .gitignore for .NET Core projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code settings
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Others
*.vspscc
*.vssscc
_ReSharper*/
*.ncrunch*
*.localhistory/
*.idea/
*.sln.ide

# NuGet
*.nupkg
# Package directories
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/

# Audio files
*.mp3
*.wav

# Environment variables
.env